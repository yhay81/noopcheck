{
  "name": "noopcheck",
  "version": "0.1.0",
  "description": "Checks whether a \"this is just a refactor\" change really changes nothing — and points at the exact files where it does",
  "keywords": [
    "refactor",
    "no-op",
    "ast",
    "diff",
    "code-review",
    "review-scope",
    "typescript",
    "ci",
    "codemod",
    "agent"
  ],
  "homepage": "https://github.com/yhay81/noopcheck#readme",
  "bugs": "https://github.com/yhay81/noopcheck/issues",
  "license": "MIT",
  "author": "Yusuke Hayashi <yusuke8h@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/noopcheck.git"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "noopcheck": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "oxc-parser": "^0.160.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
